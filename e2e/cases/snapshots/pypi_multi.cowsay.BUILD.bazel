load("//:compatibility.bzl", "compatible_with")


alias(
    name = "pkg",
    actual = "cowsay",
    visibility = ["//visibility:public"],
)
alias(
    name = "whl",
    actual = select({
          "//dep_group:beta": "@@aspect_rules_py++uv+project__beta//private/distributions/cowsay:cowsay_whl",
          "//dep_group:dev": "@@aspect_rules_py++uv+project__alpha//private/distributions/cowsay:cowsay_whl",
          "//dep_group:gamma": "@@aspect_rules_py++uv+project__gamma//private/distributions/cowsay:cowsay_whl",
          "//dep_group:unit-tests": "@@aspect_rules_py++uv+project__alpha//private/distributions/cowsay:cowsay_whl",
      }),
    target_compatible_with = select(compatible_with(["beta", "dev", "gamma", "unit-tests"])),
    visibility = ["//visibility:public"],
)
alias(
    name = "cowsay",
    actual = select({
          "//dep_group:beta": "@@aspect_rules_py++uv+project__beta//private/distributions/cowsay:cowsay",
          "//dep_group:dev": "@@aspect_rules_py++uv+project__alpha//private/distributions/cowsay:cowsay",
          "//dep_group:gamma": "@@aspect_rules_py++uv+project__gamma//private/distributions/cowsay:cowsay",
          "//dep_group:unit-tests": "@@aspect_rules_py++uv+project__alpha//private/distributions/cowsay:cowsay",
      },
        no_match_error = "Available only in dep_groups: beta, dev, gamma, unit-tests",
    ),
    target_compatible_with = select(compatible_with(["beta", "dev", "gamma", "unit-tests"])),
    visibility = ["//visibility:public"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
