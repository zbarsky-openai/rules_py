"""Demonstrate the rules_python-compatible requirements.bzl surface.

Exercises the :pkg / :whl per-package aliases, requirement(), and the
all_* exports.
"""

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(hub_name = "pypi_requirements_bzl")
uv.project(
    hub_name = "pypi_requirements_bzl",
    lock = "//uv-requirements-bzl:uv.lock",
    pyproject = "//uv-requirements-bzl:pyproject.toml",
)
uv.declare_hub(hub_name = "pypi_requirements_by_dep_group")
uv.project(
    hub_name = "pypi_requirements_by_dep_group",
    lock = "//uv-requirements-bzl:uv.lock",
    pyproject = "//uv-requirements-bzl:pyproject.toml",
)
uv.project(
    hub_name = "pypi_requirements_by_dep_group",
    lock = "//uv-requirements-bzl/empty:uv.lock",
    pyproject = "//uv-requirements-bzl/empty:pyproject.toml",
)
uv.project(
    hub_name = "pypi_requirements_by_dep_group",
    lock = "//uv-requirements-bzl/group_b:uv.lock",
    pyproject = "//uv-requirements-bzl/group_b:pyproject.toml",
)
use_repo(uv, "pypi_requirements_by_dep_group", "pypi_requirements_bzl")

# A group with zero member packages still exposes its dependency module.
empty_hub = use_repo_rule("@aspect_rules_py//uv/private/uv_hub:repository.bzl", "uv_hub")

empty_hub(
    name = "pypi_empty_group_fixture",
    configurations = {"empty": "//uv-requirements-bzl:BUILD.bazel"},
)
